"use strict";

process.stdin.resume();
process.stdin.setEncoding("utf-8");

let inputString = "";
let currentLine = 0;

process.stdin.on("data", (inputStdin) => {
  inputString += inputStdin;
});

process.stdin.on("end", (_) => {
  inputString = inputString.trim().split("\n").map((str) => str.trim());
  main();
});

function readLine() {
  return inputString[currentLine++];
}

/* Please do not modify anything above this line */

function main() {
  const isSticksFound = JSON.parse(readLine());
  const isLighterFound = JSON.parse(readLine());

  /* Write your code here */
  const gatherSticks = new Promise((resolve, reject) => {
      if (isSticksFound) {
          resolve("Sticks Gathered");
      } else {
          reject("Sticks Not Found");
      }
  });
  
  const arrangeSticks = new Promise((resolve) => {
      resolve("Sticks Arranged");
  });
  const lightCampfire = new Promise((resolve, reject) => {
      if (isLighterFound) {
          resolve("Campfire Lighted");
      } else {
          reject("Lighter Not Found");
      }
  });
  async function startCampfire() {
      try {
          const sticksMsg = await gatherSticks;
          console.log(sticksMsg);
          
          const arrangeMsg = await arrangeSticks;
          console.log(arrangeMsg);
          
          const lightMsg = await lightCampfire;
          console.log(lightMsg);
      } catch (error) {
          console.log(error);
      }
  }
  startCampfire();
}
